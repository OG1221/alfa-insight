# Local-only contest prototype. Never commit .env or real source files.
DATABASE_URL=postgresql+psycopg://alfa@127.0.0.1:55432/alfa_insight
APP_PORT=8000
DEMO_MODE=true
DEMO_TOKEN=alfa-local-demo
ADMIN_TOKEN=alfa-local-admin
# Production: use generated random tokens; never expose the defaults publicly.
LLM_MODE=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_APPROVED_NAME=
# Set only after confirming the organizer endpoint implements this protocol.
LLM_PROTOCOL=
LLM_MAX_TOKENS=1800
LLM_TIMEOUT=35
LLM_DAILY_BUDGET_RUB=500
# Required positive, confirmed prices; no prices are guessed.
LLM_INPUT_RUB_PER_MILLION=0
LLM_OUTPUT_RUB_PER_MILLION=0
AGENT_MAX_STEPS=16
AGENT_TIMEOUT=90
NEWS_HOSTS=www.cbr.ru,cbr.ru,www.interfax.ru,interfax.ru,tass.ru,www.rbc.ru
